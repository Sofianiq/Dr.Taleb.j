rules_version = '2';

// قواعد أمان قاعدة بيانات مستشفى الدكتور طالب الجنابي الأهلي
// - الإدارة (admin@dr.taleb.com): صلاحيات كاملة، وهي وحدها تعدّل الردهات والأقسام والإعدادات
// - الكادر (staff@dr.taleb.com): قراءة كل شيء + إدخال المرضى ومتابعتهم ونقلهم وإخراجهم
// - أي حساب آخر: لا يملك أي صلاحية
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'admin@dr.taleb.com'; }
    function isStaff() { return signedIn() && request.auth.token.email == 'staff@dr.taleb.com'; }
    function isMember() { return isAdmin() || isStaff(); }

    function data() { return request.resource.data; }
    function smallDoc() { return data().size() <= 40; }
    function str(field, max) {
      return !(field in data()) || (data()[field] is string && data()[field].size() <= max);
    }
    function mapField(field, maxKeys) {
      return !(field in data()) || (data()[field] is map && data()[field].size() <= maxKeys);
    }

    // إعدادات عامة: مناصب الخفارة، الأقسام، وقت بدء الخفارة
    match /settings/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // الردهات: الاسم وعدد الأسرّة ونوع الوحدة والعلامات الحيوية — الإدارة فقط
    match /wards/{wardId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ترويسة استمارة كل ردهة (التاريخ، الشفت، المقيم الدوري)
    match /sheets/{wardId} {
      allow read: if isMember();
      allow write: if isMember() && smallDoc()
        && str('date', 20) && str('shift', 40) && str('resident', 120);
    }

    // الأسرّة وبيانات المرضى
    function validBed() {
      return smallDoc()
        && str('patientName', 120) && str('age', 20) && str('sex', 10) && str('doctorName', 120)
        && str('procedure', 200) && str('familyPhone', 30) && str('notes', 3000) && str('label', 20)
        && str('admissionId', 40) && str('updatedBy', 120) && str('vitalsBy', 120)
        && (!('status' in data()) || data().status in ['occupied', 'critical', 'discharge', 'empty', 'reserved', 'cleaning'])
        && mapField('vitals', 12);
    }
    // تغيير رقم السرير المعروض للإدارة فقط
    function labelUnchanged() {
      return !('label' in data())
        || (resource == null && data().label == '')
        || (resource != null && 'label' in resource.data && data().label == resource.data.label)
        || (resource != null && !('label' in resource.data) && data().label == '');
    }
    match /beds/{bedId} {
      allow read: if isMember();
      allow create, update: if isMember() && validBed() && (isAdmin() || labelUnchanged());
      allow delete: if isAdmin();
    }

    // سجل العلامات الحيوية لكل رقود
    match /observations/{id} {
      allow read: if isMember();
      allow create: if isMember() && smallDoc() && mapField('values', 12) && str('by', 120);
      allow update, delete: if isAdmin();
    }

    // سجل النشاطات
    match /activity/{id} {
      allow read: if isMember();
      allow create: if isMember() && smallDoc() && str('text', 300) && str('by', 120);
      allow update, delete: if isAdmin();
    }

    // سجل المرضى المُخرَجين
    match /archive/{id} {
      allow read: if isMember();
      allow create: if isMember() && smallDoc() && str('dischargeNote', 1000);
      allow update, delete: if isAdmin();
    }

    // دليل الهواتف
    match /contacts/{id} {
      allow read: if isMember();
      allow write: if isAdmin()
        && (request.resource == null || (str('name', 120) && str('phone', 30) && str('note', 300)));
    }

    // جدول الخفارات (الكولات) — مستند لكل شهر
    match /shifts/{monthId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // التعاميم والتبليغات
    match /announcements/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
